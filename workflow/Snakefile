# =============================================================================
# VariantPiper — main Snakefile
# =============================================================================
# Run from the project root:
#   snakemake --snakefile workflow/Snakefile \
#             --configfile config/config.yaml \
#             --use-conda \
#             --cores <N>
# =============================================================================

configfile: "config/config.yaml"

SAMPLES      = list(config["samples"].keys())
OUTDIR       = config["outdir"]
FILTER_PASS  = config.get("filter_pass", True)

# -----------------------------------------------------------------------------
# Rule modules (one per pipeline step)
# -----------------------------------------------------------------------------
include: "rules/reference.smk"
include: "rules/qc.smk"
include: "rules/alignment.smk"
include: "rules/variant_calling.smk"
include: "rules/sv_calling.smk"


# -----------------------------------------------------------------------------
# Target rule — final outputs of the complete pipeline
# -----------------------------------------------------------------------------
rule all:
    input:
        # Step 1: QC reports
        expand(
            "{outdir}/{sample}/qc/{sample}_fastp.html",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        # Step 2: duplicate-marked BAM + index
        expand(
            "{outdir}/{sample}/alignment/{sample}.markdup.bam",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        expand(
            "{outdir}/{sample}/alignment/{sample}.markdup.bam.bai",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        # Step 3: SNV/indel calls (DeepVariant) — full VCF + gVCF + indexes
        expand(
            "{outdir}/{sample}/snv_calls/{sample}.vcf.gz",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        expand(
            "{outdir}/{sample}/snv_calls/{sample}.vcf.gz.tbi",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        expand(
            "{outdir}/{sample}/snv_calls/{sample}.g.vcf.gz",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        expand(
            "{outdir}/{sample}/snv_calls/{sample}.g.vcf.gz.tbi",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        # Step 3: PASS-filtered SNV VCF (only when filter_pass: true)
        *(expand(
            "{outdir}/{sample}/snv_calls/{sample}.pass.vcf.gz",
            outdir=OUTDIR,
            sample=SAMPLES,
        ) if FILTER_PASS else []),
        *(expand(
            "{outdir}/{sample}/snv_calls/{sample}.pass.vcf.gz.tbi",
            outdir=OUTDIR,
            sample=SAMPLES,
        ) if FILTER_PASS else []),
        # Step 4: SV calls (Manta or Delly, see sv_caller in config) — VCF + index
        expand(
            "{outdir}/{sample}/sv_calls/{sample}.sv.vcf.gz",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
        expand(
            "{outdir}/{sample}/sv_calls/{sample}.sv.vcf.gz.tbi",
            outdir=OUTDIR,
            sample=SAMPLES,
        ),
